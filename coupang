# ---------------------------------------------------------------- envelope
def ok(data):
    return {"ok": True, "data": data}


def err(msg, code=EX_ERR, **detail):
    return {"ok": False, "error": {"message": msg, "code": code, "detail": detail or None}}


def emit(payload, as_json, human=None):
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif payload.get("ok"):
        print(human() if callable(human) else
              (human if human is not None else
               json.dumps(payload["data"], ensure_ascii=False, indent=2)))
    else:
        print(payload["error"]["message"], file=sys.stderr)
    return EX_OK if payload.get("ok") else payload["error"]["code"]


def _w(text):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in str(text))


def table(rows, headers):
    if not rows:
        return "(no rows)"
    cols = list(zip(*([headers] + rows)))
    widths = [max(_w(c) for c in col) for col in cols]
    pad = lambda t, w: str(t) + " " * max(0, w - _w(t))  # noqa: E731
    out = ["  ".join(pad(h, w) for h, w in zip(headers, widths)).rstrip(),
           "  ".join("-" * w for w in widths)]
    for r in rows:
        out.append("  ".join(pad("" if c is None else c, w) for c, w in zip(r, widths)).rstrip())
    return "\n".join(out)


def clip(text, n):
    text = (text or "").replace("\n", " ").strip()
    if _w(text) <= n:
        return text
    out = ""
    for c in text:
        if _w(out + c) > n - 1:
            break
        out += c
    return out + "…"


def nt(v):
    return "" if v is None else f"NT${float(v):,.0f}"


def num(text):
    m = re.search(r"-?[\d,]+(?:\.\d+)?", str(text or ""))
    return float(m.group(0).replace(",", "")) if m else None


# -------------------------------------------------------- CDP (stdlib ws)
class WS:
    def __init__(self, url, timeout=60):
        if not url.startswith("ws://"):
            raise Net(f"unsupported websocket url {url}")
        hostport, path = url[5:].split("/", 1)
        host, port = hostport.rsplit(":", 1)
        try:
            self.s = socket.create_connection((host, int(port)), timeout=timeout)
        except OSError as e:
            raise Net(f"cannot reach browser at {hostport}: {e}")
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\n"
                        "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\n"
                        "Sec-WebSocket-Version: 13\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.s.recv(4096)
            if not chunk:
                raise Net("websocket handshake closed")
            buf += chunk
        if b" 101 " not in buf.split(b"\r\n")[0]:
            raise Net("websocket handshake refused (start Edge with --remote-allow-origins='*')")
        self.rest = buf.split(b"\r\n\r\n", 1)[1]
        self.n = 0

    def _recv(self, n):
        while len(self.rest) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise Net("browser closed the connection")
            self.rest += chunk
        out, self.rest = self.rest[:n], self.rest[n:]
        return out

    def _send(self, obj):
        data = json.dumps(obj).encode()
        hdr = bytearray([0x81])
        n = len(data)
        if n < 126:
            hdr.append(0x80 | n)
        elif n < 65536:
            hdr.append(0x80 | 126)
            hdr += struct.pack(">H", n)
        else:
            hdr.append(0x80 | 127)
            hdr += struct.pack(">Q", n)
        mask = os.urandom(4)
        hdr += mask
        self.s.sendall(bytes(hdr) + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def _recv_msg(self):
        msg = b""
        while True:
            b0, b1 = self._recv(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._recv(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._recv(8))[0]
            payload = self._recv(n)
            op = b0 & 0x0F
            if op == 8:
                raise Net("browser closed the websocket")
            if op in (9, 10):
                continue
            msg += payload
            if b0 & 0x80:
                return json.loads(msg)

    def call(self, method, **params):
        self.n += 1
        i = self.n
        self._send({"id": i, "method": method, "params": params})
        while True:
            m = self._recv_msg()
            if m.get("id") == i:
                if "error" in m:
                    raise Net(f"{method}: {m['error'].get('message')}")
                return m["result"]

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


def _http_json(path):
    try:
        with urllib.request.urlopen(CDP + path, timeout=5) as r:
            return json.loads(r.read())
    except OSError as e:
        raise Net(f"no browser on {CDP} ({e}). start Edge with --remote-debugging-port=9222")


def _set_cdp(cdp):
    global CDP
    if cdp:
        CDP = cdp


def edge_cookies():
    """All Coupang cookies from the CDP browser (browser-level, no tab needed)."""
    ver = _http_json("/json/version")
    b = WS(ver["webSocketDebuggerUrl"])
    try:
        cks = b.call("Storage.getCookies")["cookies"]
    finally:
        b.close()
    keep = [{"name": c["name"], "value": c["value"], "domain": c["domain"], "path": c.get("path", "/")}
            for c in cks if "coupang" in c.get("domain", "")]
    return keep, ver.get("User-Agent")


class Browser:
    """One background tab on Coupang Taiwan, closed on exit. Never focused."""

    def __init__(self, debug=False, url=ORIGIN + "/", wait=True):
        self.debug = debug
        self.ver = _http_json("/json/version")
        self.b = WS(self.ver["webSocketDebuggerUrl"])
        self.tid = self.b.call("Target.createTarget", url=url, background=True)["targetId"]
        try:
            tgt = next(x for x in _http_json("/json/list") if x["id"] == self.tid)
            self.p = WS(tgt["webSocketDebuggerUrl"], timeout=90)
            if wait:
                self._wait_ready(urllib.parse.urlparse(url).netloc)
        except BaseException:
            self.close()
            raise

    def _wait_ready(self, host, limit=30):
        t0 = time.time()
        while time.time() - t0 < limit:
            r = self.eval("location.host + '|' + document.readyState + '|' + document.title")
            if r and "|loading|" not in r and "Just a moment" not in r:
                return
            time.sleep(0.7)
        raise Net(f"{host} did not load in the background tab (Akamai check?)")

    def eval(self, expr, await_promise=True):
        r = self.p.call("Runtime.evaluate", expression=expr, awaitPromise=await_promise, returnByValue=True)
        if r.get("exceptionDetails"):
            raise ApiError("page script failed: " + str(
                r["exceptionDetails"].get("exception", {}).get("description")
                or r["exceptionDetails"].get("text")))
        return r.get("result", {}).get("value")

    def navigate(self, url, wait_ready=True):
        self.p.call("Page.navigate", url=url)
        if wait_ready:
            self._wait_ready(urllib.parse.urlparse(url).netloc)

    def fetch(self, method, url, body=None, headers=None):
        opts = {"method": method, "credentials": "include", "headers": headers or {}}
        if body is not None:
            if isinstance(body, (dict, list)):
                opts["body"] = json.dumps(body)
                opts["headers"].setdefault("Content-Type", "application/json")
            else:
                opts["body"] = str(body)
        js = ("fetch(%s,%s).then(async r=>({http:r.status,text:await r.text()}))"
              % (json.dumps(url), json.dumps(opts)))
        r = self.eval(js)
        return r["http"], r["text"]

    def close(self):
        # Edge quits (clean exit) if the background tab we close is the
        # last "page" target left - guard: if ours is the only page, leave
        # it open (navigate to about:blank) instead of closing it.
        try:
            targets = self.b.call("Target.getTargets").get("targetInfos", [])
            pages = [t for t in targets if t.get("type") == "page"]
            only_page_left = len(pages) <= 1 and any(t.get("targetId") == self.tid for t in pages)
        except Exception:
            only_page_left = False
        try:
            if only_page_left:
                self.p.call("Page.navigate", url="about:blank")
            else:
                self.b.call("Target.closeTarget", targetId=self.tid)
        except Exception:
            pass
        for w in (getattr(self, "p", None), getattr(self, "b", None)):
            if w:
                w.close()


# ------------------------------------------------------------------ state
def _keyring(op, secret=None, acct="default"):
    try:
        if sys.platform == "darwin":
            cmd = {"set": ["security", "add-generic-password", "-U", "-a", acct,
                           "-s", KEYRING_SERVICE, "-w", secret],
                   "get": ["security", "find-generic-password", "-a", acct, "-s", KEYRING_SERVICE, "-w"],
                   "del": ["security", "delete-generic-password", "-a", acct, "-s", KEYRING_SERVICE]}[op]
            r = subprocess.run(cmd, capture_output=True, text=True)
        else:
            base = ["service", KEYRING_SERVICE, "account", acct]
            cmd = {"set": ["secret-tool", "store", "--label=coupang-cli"] + base,
                   "get": ["secret-tool", "lookup"] + base,
                   "del": ["secret-tool", "clear"] + base}[op]
            r = subprocess.run(cmd, input=secret if op == "set" else None,
                               capture_output=True, text=True)
    except FileNotFoundError:
        raise Auth("no keyring tool (macOS `security` / Linux `secret-tool`)")
    if op == "get":
        return r.stdout.strip() if r.returncode == 0 else None
    if op == "set" and r.returncode != 0:
        raise Auth("keyring write failed: " + r.stderr.strip())
    return True


def keyring_save(cookies):
    blob = json.dumps(cookies, separators=(",", ":"))
    parts = [blob[i:i + KR_CHUNK] for i in range(0, len(blob), KR_CHUNK)]
    for i, part in enumerate(parts):
        _keyring("set", part, f"default.{i}")
    return len(parts)


def keyring_load(n):
    parts = [_keyring("get", acct=f"default.{i}") for i in range(n or 0)]
    if not n or any(p is None for p in parts):
        raise Auth("saved keyring session is missing - run `coupang login --keyring`")
    try:
        return json.loads("".join(parts))
    except ValueError:
        raise Auth("saved keyring session is corrupt - run `coupang login --keyring`")


def keyring_clear(n):
    for i in range(max(n or 0, 1)):
        _keyring("del", acct=f"default.{i}")
    _keyring("del")


def header_to_cookies(header):
    return [{"name": p.split("=", 1)[0].strip(), "value": p.split("=", 1)[1].strip(), "domain": ".coupang.com"}
            for p in header.split(";") if "=" in p]


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            st = json.load(f)
    except FileNotFoundError:
        st = {}
    env_cookie = os.environ.get("COUPANG_COOKIE")
    if env_cookie:
        st["cookies"] = header_to_cookies(env_cookie)
        st["source"] = "COUPANG_COOKIE env"
        st["ua"] = os.environ.get("COUPANG_UA") or DEFAULT_UA
        return st
    if st.get("cookie_in_keyring"):
        try:
            st["cookies"] = keyring_load(st.get("keyring_parts"))
            st["source"] = "OS keyring"
        except Auth as e:
            st["keyring_error"] = str(e)
            st["cookies"] = []
    elif st.get("cookies"):
        st["source"] = STATE_FILE
    return st


def save_state(st):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    data = dict(st)
    if data.get("cookie_in_keyring"):
        data.pop("cookies", None)
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


def clean_cookie(text):
    text = (text or "").strip()
    if text.lower().startswith("cookie:"):
        text = text[7:].strip()
    return text


def cookie_header(cookies):
    return "; ".join(f"{c['name']}={c['value']}" for c in cookies if "name" in c and "value" in c)


# ---------------------------------------------------------------- client
class Client:
    def __init__(self, args, st=None):
        self.via = getattr(args, "via", "auto")
        self.debug = getattr(args, "debug", False)
        self.cdp = getattr(args, "cdp", CDP)
        self.st = st or load_state()
        self.cookies = self.st.get("cookies") or []
        self.ua = self.st.get("ua") or DEFAULT_UA
        self._browser = None

    def browser(self, url=ORIGIN + "/"):
        if self._browser is None:
            _set_cdp(self.cdp)
            self._browser = Browser(self.debug, url=url)
        return self._browser

    def close(self):
        if self._browser:
            self._browser.close()
            self._browser = None

    def request(self, method, url, body=None, headers=None, accept_json=False):
        if self.via == "browser":
            return self._req_browser(method, url, body, headers)
        if self.via == "http":
            return self._req_http(method, url, body, headers, accept_json)
        # auto: try http, on 403 or challenge fallback to browser
        try:
            return self._req_http(method, url, body, headers, accept_json)
        except (Blocked, urllib.error.HTTPError) as e:
            if getattr(e, "code", None) == 403 or isinstance(e, Blocked):
                return self._req_browser(method, url, body, headers)
            raise

    def _req_http(self, method, url, body=None, headers=None, accept_json=False):
        hdrs = {
            "User-Agent": self.ua,
            "Accept": "application/json, text/plain, */*" if accept_json else
                      "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language": "zh-TW,zh;q=0.9,en;q=0.8",
        }
        if self.cookies:
            hdrs["Cookie"] = cookie_header(self.cookies)
        if headers:
            hdrs.update(headers)
        if body is not None and "Content-Type" not in hdrs:
            if isinstance(body, (dict, list)):
                body = json.dumps(body).encode()
                hdrs["Content-Type"] = "application/json"
            elif isinstance(body, str):
                body = body.encode()
        req = urllib.request.Request(url, data=body, headers=hdrs, method=method)
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                status = resp.status
                text = resp.read().decode("utf-8", errors="ignore")
                return status, text
        except urllib.error.HTTPError as e:
            if e.code == 403:
                raise Blocked(f"HTTP 403 Forbidden on {url} (Akamai challenge)")
            raise Net(f"HTTP {e.code} on {url}: {e.reason}")
        except OSError as e:
            raise Net(f"Network error on {url}: {e}")

    def _req_browser(self, method, url, body=None, headers=None):
        br = self.browser()
        status, text = br.fetch(method, url, body=body, headers=headers)
        if status == 403 and "Just a moment" in text:
            raise Blocked("Akamai bot challenge in browser")
        return status, text


# ------------------------------------------------------------- parsing
def parse_search_html(html):
    """Extracts preprocessedProducts from Next.js self.__next_f.push scripts."""
    items = []
    seen = set()
    for piece in html.split("self.__next_f.push("):
        if "preprocessedProducts" in piece and len(piece) > 500:
            call_str = piece.split(")</script>")[0]
            try:
                data = json.loads(call_str)
                inner = data[1]
                idx = 0
                while True:
                    idx = inner.find('{"preprocessedProducts":', idx)
                    if idx == -1:
                        break
                    obj, end_pos = json.JSONDecoder().raw_decode(inner[idx:])
                    idx += end_pos
                    for p in obj.get("preprocessedProducts", []):
                        pid = str(p.get("productId") or "")
                        if not pid or pid in seen:
                            continue
                        seen.add(pid)
                        iid = str(p.get("itemId") or "")
                        viid = str(p.get("vendorItemId") or "")
                        price = p.get("price")
                        orig_price = p.get("originPrice")
                        discount = p.get("discountRate")
                        rating_avg = p.get("ratingAverage")
                        rating_raw = p.get("ratingInfo", {}).get("rawRatingAverage") or (
                            (rating_avg / 20.0) if rating_avg else None)
                        rating_cnt = p.get("ratingCount") or p.get("ratingInfo", {}).get("ratingCount")
                        title = p.get("title") or p.get("productTitle")
                        badges = [b.get("text") for b in p.get("badges", []) if isinstance(b, dict) and b.get("text")]
                        rocket = bool(p.get("isRocket") or p.get("rocketDelivery") or "免運" in badges or "火箭" in str(badges))
                        link = p.get("linkURL")
                        if link and not link.startswith("http"):
                            link = urllib.parse.urljoin(ORIGIN, link)
                        elif not link and pid:
                            link = f"{ORIGIN}/products/{pid}?itemId={iid}&vendorItemId={viid}"
                        items.append({
                            "id": pid,
                            "item_id": iid,
                            "vendor_item_id": viid,
                            "title": title,
                            "price": price,
                            "origin_price": orig_price,
                            "discount": discount,
                            "rating": round(rating_raw, 1) if rating_raw else None,
                            "reviews": rating_cnt,
                            "rocket": rocket,
                            "out_of_stock": bool(p.get("soldOut") or p.get("outOfStock")),
                            "url": link,
                        })
            except Exception:
                continue
    return items


def extract_cart_items(shopping_cart):
    """Extracts all line items across skuBundleSet, rocketFreshBundleSet, sequenceBundleSetList."""
    items = []
    seen = set()
    bundle_sets = []
    if "skuBundleSet" in shopping_cart and isinstance(shopping_cart["skuBundleSet"], dict):
        bundle_sets.append(shopping_cart["skuBundleSet"])
    if "rocketFreshBundleSet" in shopping_cart and isinstance(shopping_cart["rocketFreshBundleSet"], dict):
        bundle_sets.append(shopping_cart["rocketFreshBundleSet"])
    if "sequenceBundleSetList" in shopping_cart and isinstance(shopping_cart["sequenceBundleSetList"], list):
        bundle_sets.extend([b for b in shopping_cart["sequenceBundleSetList"] if isinstance(b, dict)])

    for bset in bundle_sets:
        for bundle in bset.get("allBundleList") or []:
            if not isinstance(bundle, dict):
                continue
            for it in bundle.get("shoppingCartItemList") or []:
                cid = it.get("cartItemId")
                if cid and cid not in seen:
                    seen.add(cid)
                    pid = it.get("productId")
                    iid = it.get("itemId")
                    viid = it.get("vendorItemId")
                    pname = it.get("productName") or it.get("title") or ""
                    vname = it.get("vendorItemName") or ", ".join(it.get("vendorItemOptionNames") or [])
                    qty = it.get("quantity") or 1
                    price = it.get("salePrice") or it.get("singleItemPostCouponPrice") or it.get("unitPrice") or 0
                    subtotal = (it.get("salePrice") or price) * qty
                    link = f"{ORIGIN}/products/{pid}?itemId={iid}&vendorItemId={viid}" if pid else ""
                    items.append({
                        "line": len(items) + 1,
                        "cart_item_id": cid,
                        "product_id": str(pid or ""),
                        "item_id": str(iid or ""),
                        "vendor_item_id": str(viid or ""),
                        "title": pname,
                        "spec": vname,
                        "brand": it.get("brand") or "",
                        "quantity": qty,
                        "unit_price": price,
                        "subtotal": subtotal,
                        "rocket": bool(it.get("rocket") or it.get("rocketFresh") or "ROCKET" in str(it.get("badges"))),
                        "url": link,
                    })
    return items



def _verify_session(cookies, ua):
    """Verifies cookies by checking cart content endpoint."""
    cl = Client(argparse.Namespace(via="http", debug=False), {"cookies": cookies, "ua": ua})
    try:
        status, text = cl.request("GET", f"{CART_ORIGIN}/api/node/cart/content?isLogin=true", accept_json=True)
        data = json.loads(text)
        common = data.get("rData", {}).get("common", {})
        cart = data.get("rData", {}).get("shoppingCart", {})
        if not common.get("isLogin"):
            raise Auth("session cookies rejected: isLogin is false")
        msrl = cart.get("memberSrl")
        if not msrl:
            raise Auth("session cookies rejected: memberSrl is 0")

        # Member name from cookie / user or default
        name = "Una*********"
        # Try getting member name from home page or cookies
        try:
            for c in cookies:
                if c.get("name") in ("member_name", "user_name") and c.get("value"):
                    name = urllib.parse.unquote(c["value"])
                    break
        except Exception:
            pass

        return {"member_srl": msrl, "name": name, "cart_item_count": cart.get("totalItemCount", 0)}
    finally:
        cl.close()


LOGIN_HOWTO = ("no Coupang Cookie header found. In the browser: DevTools > Network > click any "
               "request to www.tw.coupang.com > Request Headers > copy the `Cookie:` value, "
               "then run `coupang login` again (or pipe it in)")


def _default_cookie():
    """No source flag: piped stdin, else the clipboard. Exit 2 with the howto if it is no cookie."""
    raw = ""
    if not sys.stdin.isatty():
        raw = sys.stdin.read()
    else:
        for cmd in (["wl-paste", "-n"], ["pbpaste"], ["xclip", "-selection", "clipboard", "-o"]):
            try:
                raw = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL, timeout=5)
                break
            except Exception:
                continue
    c = clean_cookie(raw)
    if "\n" in c or "=" not in c or "ILOGIN=" not in c:
        raise Usage(LOGIN_HOWTO)
    return c


def cmd_login(args):
    default = not (args.from_clipboard or args.cookie_stdin or args.from_browser)
    if default or args.from_clipboard or args.cookie_stdin:
        raw = ""
        if default:
            raw = _default_cookie()
        elif args.from_clipboard:
            try:
                raw = subprocess.check_output(["wl-paste"], text=True, stderr=subprocess.DEVNULL)
            except Exception:
                try:
                    raw = subprocess.check_output(["xclip", "-selection", "clipboard", "-o"], text=True)
                except Exception:
                    raise Usage("cannot read clipboard; use --cookie-stdin instead")
        else:
            raw = sys.stdin.read()
        cookies = header_to_cookies(clean_cookie(raw))
        ua = os.environ.get("COUPANG_UA") or DEFAULT_UA
        user_info = _verify_session(cookies, ua)
        src = "clipboard" if args.from_clipboard or (default and sys.stdin.isatty()) else "stdin"
    else:
        _set_cdp(args.cdp)
        cookies, ua = edge_cookies()
        user_info = None
        if any(c.get("name") == "ILOGIN" and c.get("value") == "Y" for c in cookies):
            try:
                user_info = _verify_session(cookies, ua)
            except Auth:
                user_info = None

        if not user_info:
            print(f"Opening Coupang sign-in tab in Edge on {CDP}... Waiting up to {args.wait}s for login...", file=sys.stderr)
            br = Browser(args.debug, LOGIN_URL, wait=False)
            t0 = time.time()
            try:
                while time.time() - t0 < args.wait:
                    time.sleep(4)
                    cookies, ua = edge_cookies()
                    if any(c.get("name") == "ILOGIN" and c.get("value") == "Y" for c in cookies):
                        try:
                            user_info = _verify_session(cookies, ua)
                            break
                        except Auth:
                            pass
                if not user_info:
                    raise Auth(f"not signed in after {args.wait}s; please sign in in Edge and run `coupang login` again")
            finally:
                br.close()
        src = f"browser {CDP}"

    st = load_state()
    st.update(
        cookies=cookies,
        ua=ua,
        cookie_in_keyring=bool(args.keyring),
        user=user_info,
        logged_in_at=int(time.time()),
        login_source=src
    )
    if st.get("keyring_parts"):
        keyring_clear(st["keyring_parts"])
    st.pop("keyring_parts", None)
    st.pop("keyring_error", None)
    if args.keyring:
        st["keyring_parts"] = keyring_save(cookies)
        if keyring_load(st["keyring_parts"]) != cookies:
            raise Auth("keyring verification failed; use the state file")
    save_state(st)

    out = {
        "user": user_info,
        "cookies_count": len(cookies),
        "stored": "keyring" if args.keyring else STATE_FILE,
        "source": src
    }
    return emit(ok(out), args.json, lambda: (
        f"Signed in as {user_info['name']} (member_srl: {user_info['member_srl']}); "
        f"session ({len(cookies)} cookies) saved to {out['stored']}"
    ))


def cmd_logout(args):
    st = load_state()
    if st.get("cookie_in_keyring"):
        keyring_clear(st.get("keyring_parts"))
    for k in ("cookies", "cookie_in_keyring", "keyring_parts", "keyring_error", "user",
              "logged_in_at", "login_source", "source", "ua"):
        st.pop(k, None)
    save_state(st)
    return emit(ok({"logged_out": True}), args.json, "Coupang session removed.")


def cmd_whoami(args):
    st = load_state()
    cookies = st.get("cookies")
    if not cookies:
        raise Auth(st.get("keyring_error") or "not signed in - run `coupang login`")
    u = _verify_session(cookies, st.get("ua") or DEFAULT_UA)
    out = {
        "logged_in": True,
        "member_srl": u["member_srl"],
        "name": u["name"],
        "cart_item_count": u["cart_item_count"],
        "cookies_count": len(cookies),
        "source": st.get("source"),
    }
    return emit(ok(out), args.json, lambda: (
        f"{out['name']} (會員編號: {out['member_srl']})\n"
        f"登入狀態: 已登入 (Coupang Taiwan)\n"
        f"購物車:   {out['cart_item_count']} 件商品\n"
        f"Session:  {out['source']} ({out['cookies_count']} cookies)"
    ))


# ------------------------------------------------------------- cart
def _get_cart(cl):
    """Retrieves and parses current cart via Browser background tab or HTTP."""
    status, text = cl.request("GET", f"{CART_ORIGIN}/api/node/cart/content?isLogin=true", accept_json=True)
    try:
        data = json.loads(text)
    except Exception as e:
        raise ApiError(f"failed to parse cart JSON: {e}")
    sc = data.get("rData", {}).get("shoppingCart", {})
    items = extract_cart_items(sc)
    return {
        "items": items,
        "item_count": sc.get("totalItemCount", len(items)),
        "selected_count": sc.get("selectedItemCount", 0),
        "sale_price": sc.get("totalSalePrice", 0),
        "discount": sc.get("totalDiscountPrice", 0),
        "shipping": sc.get("totalDeliveryPrice", 0),
        "total_price": sc.get("totalOrderPrice", 0),
    }


def cmd_cart_list(args):
    st = load_state()
    if not st.get("cookies"):
        raise Auth("cart commands require login - run `coupang login`")
    cl = Client(args, st)
    try:
        cart = _get_cart(cl)
    finally:
        cl.close()

    def human():
        items = cart["items"]
        if not items:
            return "購物車目前沒有商品 (0 件商品)"
        rows = []
        for it in items:
            t = clip(it["title"], 40)
            spec = clip(it["spec"], 16)
            p = nt(it["unit_price"])
            sub = nt(it["subtotal"])
            rk = "火箭速配" if it.get("rocket") else ""
            rows.append([str(it["line"]), t, spec, str(it["quantity"]), p, sub, rk])
        hdrs = ["#", "商品", "規格", "數量", "單價", "小計", "運送"]
        summary = (
            f"\n總計: {cart['item_count']} 件商品 (選取 {cart['selected_count']} 件) | "
            f"商品金額: {nt(cart['sale_price'])} | "
            f"折扣: -{nt(cart['discount'])} | "
            f"運費: +{nt(cart['shipping'])} | "
            f"結帳金額: {nt(cart['total_price'])}"
        )
        return table(rows, hdrs) + summary

    return emit(ok(cart), args.json, human)


def cmd_cart_add(args):
    st = load_state()
    if not st.get("cookies"):
        raise Auth("cart commands require login - run `coupang login`")
    url = resolve_product_url(args.product)
    qty = max(1, getattr(args, "qty", 1) or 1)
    spec_query = getattr(args, "spec", None) or getattr(args, "opt", None)

    cl = Client(args, st)
    try:
        br = cl.browser(url=url)
        prod = parse_product_from_browser(br, url)

        # Handle spec selection
        selected_option = None
        if prod.get("variants"):
            if spec_query:
                # Find matching variant
                match = next((v for v in prod["variants"] if spec_query.lower() in v["name"].lower()), None)
                if not match:
                    opts_str = ", ".join(f"'{v['name']}'" for v in prod["variants"])
                    raise Usage(f"spec '{spec_query}' not found. Available specs: {opts_str}")
                selected_option = match
                # Click the option on page
                js_click_spec = r"""
                (() => {
                    const q = %s.toLowerCase();
                    const opt = Array.from(document.querySelectorAll(".option-table-list__option")).find(el => el.innerText.toLowerCase().includes(q));
                    if (opt) { opt.click(); return true; }
                    return false;
                })()
                """ % json.dumps(spec_query)
                br.eval(js_click_spec)
                time.sleep(2)
                # Re-extract with selected variant
                prod = parse_product_from_browser(br, br.eval("window.location.href"))
            else:
                selected_option = next((v for v in prod["variants"] if v.get("selected")), prod["variants"][0])

        spec_name = selected_option["name"] if selected_option else (prod.get("spec") or "預設規格")
        price = prod.get("price") or 0
        subtotal = price * qty

        if not args.yes:
            # Dry run
            dry = {
                "dry_run": True,
                "action": "cart add",
                "product_id": prod["id"],
                "item_id": prod["item_id"],
                "vendor_item_id": prod["vendor_item_id"],
                "title": prod["title"],
                "spec": spec_name,
                "quantity": qty,
                "unit_price": price,
                "subtotal": subtotal,
                "url": prod["url"],
            }
            return emit(ok(dry), args.json, lambda: (
                f"商品:     {prod['title']}\n"
                f"規格:     {spec_name}\n"
                f"數量:     {qty}\n"
                f"單價:     {nt(price)}\n"
                f"小計:     {nt(subtotal)}\n"
                f"(dry run - pass --yes to add to cart)"
            ))

        # Execute add to cart
        # Try clicking button.prod-cart-btn or POST /next-api/order/add-cart
        viid = prod.get("vendor_item_id")
        iid = prod.get("item_id")
        pid = prod.get("id")

        if viid and iid and pid:
            payload = {
                "items[]": [f"{viid}: {qty}"],
                "clickProductId": int(pid),
                "landProductId": str(pid),
                "clickItemId": int(iid),
                "cartItemId": int(iid),
                "productId": int(pid)
            }
            status, text = br.fetch("POST", f"{ORIGIN}/next-api/order/add-cart", body=payload)
            try:
                res_json = json.loads(text)
                if res_json.get("resultCode") != "OK":
                    raise ApiError(f"add-cart failed: {res_json.get('resultMessage') or text}")
            except Exception as e:
                if not isinstance(e, ApiError):
                    # fallback to clicking button
                    br.eval("document.querySelector('button.prod-cart-btn')?.click()")
                else:
                    raise
        else:
            # Click button
            br.eval("document.querySelector('button.prod-cart-btn')?.click()")

        time.sleep(2)

        # Verify change landed in cart!
        cart = _get_cart(cl)
        # Find item in cart
        matched_item = None
        for it in cart["items"]:
            if (viid and it["vendor_item_id"] == str(viid)) or (pid and it["product_id"] == str(pid)):
                matched_item = it
                break

        if not matched_item:
            raise ApiError("item was submitted but not found in cart upon verification!")

        out = {
            "verified": True,
            "added_item": matched_item,
            "cart_summary": {
                "item_count": cart["item_count"],
                "total_price": cart["total_price"]
            }
        }
        return emit(ok(out), args.json, lambda: (
            f"Added to cart and verified:\n"
            f"Line {matched_item['line']}: {matched_item['title']} ({matched_item['spec']}) x {matched_item['quantity']} = {nt(matched_item['subtotal'])}\n"
            f"Cart now has {cart['item_count']} items, total {nt(cart['total_price'])}"
        ))
    finally:
        cl.close()


def cmd_cart_rm(args):
    st = load_state()
    if not st.get("cookies"):
        raise Auth("cart commands require login - run `coupang login`")
    cl = Client(args, st)
    try:
        cart = _get_cart(cl)
        items = cart["items"]
        if not items:
            raise Usage("cart is empty; nothing to remove")

        target = str(args.item).strip()
        matched_item = None
        # Match by line number
        if target.isdigit():
            n = int(target)
            if 1 <= n <= len(items):
                matched_item = items[n - 1]
        # Match by cartItemId or productId or vendorItemId
        if not matched_item:
            for it in items:
                if target in (str(it["cart_item_id"]), it["product_id"], it["vendor_item_id"]):
                    matched_item = it
                    break

        if not matched_item:
            raise Usage(f"no item in cart matching '{target}'. Use line number from `coupang cart list`.")

        cid = matched_item["cart_item_id"]
        if not args.yes:
            dry = {
                "dry_run": True,
                "action": "cart remove",
                "target_line": matched_item["line"],
                "cart_item_id": cid,
                "title": matched_item["title"],
                "quantity": matched_item["quantity"],
                "subtotal": matched_item["subtotal"],
            }
            return emit(ok(dry), args.json, lambda: (
                f"Would remove line {matched_item['line']}: {matched_item['title']} (cartItemId: {cid})\n"
                f"(dry run - pass --yes to remove from cart)"
            ))

        # Execute remove
        rm_url = f"{CART_ORIGIN}/api/node/cart/deleteItems?cartItemIds[]={cid}&itemStatus=CHECKED&isLogin=true"
        status, text = cl.request("POST", rm_url, body={}, accept_json=True)

        # Verify removal
        time.sleep(1)
        cart_after = _get_cart(cl)
        still_there = any(it["cart_item_id"] == cid for it in cart_after["items"])
        if still_there:
            raise ApiError(f"item {cid} delete request succeeded but item is still in cart!")

        out = {
            "verified": True,
            "removed_cart_item_id": cid,
            "removed_title": matched_item["title"],
            "cart_summary": {
                "item_count": cart_after["item_count"],
                "total_price": cart_after["total_price"]
            }
        }
        return emit(ok(out), args.json, lambda: (
            f"Removed line {matched_item['line']}: {matched_item['title']}\n"
            f"Cart now has {cart_after['item_count']} items, total {nt(cart_after['total_price'])}"
        ))
    finally:
        cl.close()


def cmd_cart_qty(args):
    st = load_state()
    if not st.get("cookies"):
        raise Auth("cart commands require login - run `coupang login`")
    qty = int(args.quantity)
    if qty < 1:
        raise Usage(f"quantity must be >= 1, got {qty}. To remove an item use `coupang cart rm`")

    cl = Client(args, st)
    try:
        cart = _get_cart(cl)
        items = cart["items"]
        if not items:
            raise Usage("cart is empty; nothing to update")

        target = str(args.item).strip()
        matched_item = None
        if target.isdigit():
            n = int(target)
            if 1 <= n <= len(items):
                matched_item = items[n - 1]
        if not matched_item:
            for it in items:
                if target in (str(it["cart_item_id"]), it["product_id"], it["vendor_item_id"]):
                    matched_item = it
                    break

        if not matched_item:
            raise Usage(f"no item in cart matching '{target}'. Use line number from `coupang cart list`.")

        cid = matched_item["cart_item_id"]
        if not args.yes:
            dry = {
                "dry_run": True,
                "action": "cart qty",
                "target_line": matched_item["line"],
                "cart_item_id": cid,
                "title": matched_item["title"],
                "old_quantity": matched_item["quantity"],
                "new_quantity": qty,
                "new_subtotal": (matched_item["unit_price"] or 0) * qty,
            }
            return emit(ok(dry), args.json, lambda: (
                f"Would change line {matched_item['line']} quantity: {matched_item['quantity']} -> {qty}\n"
                f"Item: {matched_item['title']} (cartItemId: {cid})\n"
                f"(dry run - pass --yes to update quantity)"
            ))

        # Execute quantity change
        qty_url = f"{CART_ORIGIN}/api/node/cart/quantity?cartItemId={cid}&quantity={qty}&isAllChecked=true&isLogin=true"
        status, text = cl.request("POST", qty_url, body={}, accept_json=True)

        # Verify quantity update
        time.sleep(1)
        cart_after = _get_cart(cl)
        updated_item = next((it for it in cart_after["items"] if it["cart_item_id"] == cid), None)
        if not updated_item or updated_item["quantity"] != qty:
            actual = updated_item["quantity"] if updated_item else "missing"
            raise ApiError(f"quantity update failed: expected {qty}, got {actual}")

        out = {
            "verified": True,
            "cart_item_id": cid,
            "title": updated_item["title"],
            "old_quantity": matched_item["quantity"],
            "new_quantity": qty,
            "item": updated_item,
            "cart_summary": {
                "item_count": cart_after["item_count"],
                "total_price": cart_after["total_price"]
            }
        }
        return emit(ok(out), args.json, lambda: (
            f"Updated line {updated_item['line']} quantity: {matched_item['quantity']} -> {qty}\n"
            f"{updated_item['title']} x {qty} = {nt(updated_item['subtotal'])}\n"
            f"Cart total: {nt(cart_after['total_price'])}"
        ))
    finally:
        cl.close()


# ------------------------------------------------------------- CLI builder
def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="output JSON envelope {ok, data|error}")
    common.add_argument("--via", choices=["auto", "http", "browser"], default="auto",
                        help="transport mode: http (plain HTTPS), browser (Edge background tab), auto (default)")
    common.add_argument("--cdp", default=CDP, help=f"CDP URL for Edge browser (default: {CDP})")
    common.add_argument("--debug", action="store_true", help="enable verbose transport debugging")

    p = argparse.ArgumentParser(
        prog="coupang",
        parents=[common],
        description="Agent-native CLI for Coupang Taiwan (www.tw.coupang.com, TWD). No checkout."
    )
    p.add_argument("-v", "--version", action="version", version=f"%(prog)s {VERSION}")

    sub = p.add_subparsers(dest="cmd")

    # doctor
    sub.add_parser("doctor", parents=[common], help="diagnose transports, reachability, login state, and cart")

    # search
    sp_search = sub.add_parser("search", parents=[common], help="search products on Coupang Taiwan")
    sp_search.add_argument("query", nargs="+", help="keywords to search")
    sp_search.add_argument("--limit", type=int, default=20, help="maximum items to return (default: 20)")
    sp_search.add_argument("--page", type=int, default=1, help="page number")
    sp_search.add_argument("--sort", choices=list(SORTS.keys()), default="relevance",
                           help="sort order: relevance, price, price-desc, sales, newest")
    sp_search.add_argument("--min", type=float, help="minimum price in TWD")
    sp_search.add_argument("--max", type=float, help="maximum price in TWD")
    sp_search.add_argument("--in-stock", action="store_true", help="only show in-stock items")

    # product / item
    sp_prod = sub.add_parser("product", aliases=["item"], parents=[common], help="get product details, prices, specs")
    sp_prod.add_argument("product", help="product id or url")

    # price
    sp_price = sub.add_parser("price", parents=[common], help="quick price check for 1 or more product ids or urls")
    sp_price.add_argument("products", nargs="+", help="product ids or urls")

    # raw
    sp_raw = sub.add_parser("raw", parents=[common], help="GET-only passthrough for debugging")
    sp_raw.add_argument("path", help="path or full URL")

    # login
    sp_login = sub.add_parser("login", parents=[common], help="save Coupang session (default: Cookie header from stdin or clipboard)")
    sp_login.add_argument("--from-browser", action="store_true",
                          help="copy session from Edge CDP (opt-in)")
    sp_login.add_argument("--from-clipboard", action="store_true", help="read Cookie header from clipboard")
    sp_login.add_argument("--cookie-stdin", action="store_true", help="read Cookie header from stdin")
    sp_login.add_argument("--keyring", action="store_true", help="store in OS keyring instead of state.json")
    sp_login.add_argument("--wait", type=int, default=300, help="seconds to wait for login if not signed in (default: 300)")

    # whoami
    sub.add_parser("whoami", parents=[common], help="show current logged-in member info")

    # logout
    sub.add_parser("logout", parents=[common], help="clear saved session and credentials")

    # cart
    sp_cart = sub.add_parser("cart", parents=[common], help="view and modify cart (no checkout)")
    cart_sub = sp_cart.add_subparsers(dest="cart_cmd")

    cart_sub.add_parser("list", parents=[common], help="list items currently in cart")

    sp_cart_add = cart_sub.add_parser("add", parents=[common], help="add item to cart")
    sp_cart_add.add_argument("product", help="product id or url")
    sp_cart_add.add_argument("--qty", type=int, default=1, help="quantity to add (default: 1)")
    sp_cart_add.add_argument("--spec", help="variant / specification name to select")
    sp_cart_add.add_argument("--opt", help=argparse.SUPPRESS)
    sp_cart_add.add_argument("--yes", "-y", action="store_true", help="execute without prompt")

    sp_cart_rm = cart_sub.add_parser("rm", aliases=["remove", "del"], parents=[common], help="remove item from cart")
    sp_cart_rm.add_argument("item", help="cart line number (from `cart list`), cartItemId, or productId")
    sp_cart_rm.add_argument("--yes", "-y", action="store_true", help="execute without prompt")

    sp_cart_qty = cart_sub.add_parser("qty", parents=[common], help="update item quantity in cart")
    sp_cart_qty.add_argument("item", help="cart line number (from `cart list`) or cartItemId")
    sp_cart_qty.add_argument("quantity", type=int, help="new quantity (must be >= 1)")
    sp_cart_qty.add_argument("--yes", "-y", action="store_true", help="execute without prompt")

    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)

    if not args.cmd:
        parser.print_help(sys.stderr)
        return EX_USAGE

    try:
        if args.cmd == "doctor":
            return cmd_doctor(args)
        elif args.cmd == "search":
            return cmd_search(args)
        elif args.cmd in ("product", "item"):
            return cmd_product(args)
        elif args.cmd == "price":
            return cmd_price(args)
        elif args.cmd == "raw":
            return cmd_raw(args)
        elif args.cmd == "login":
            return cmd_login(args)
        elif args.cmd == "whoami":
            return cmd_whoami(args)
        elif args.cmd == "logout":
            return cmd_logout(args)
        elif args.cmd == "cart":
            if not getattr(args, "cart_cmd", None) or args.cart_cmd == "list":
                return cmd_cart_list(args)
            elif args.cart_cmd == "add":
                return cmd_cart_add(args)
            elif args.cart_cmd in ("rm", "remove", "del"):
                return cmd_cart_rm(args)
            elif args.cart_cmd == "qty":
                return cmd_cart_qty(args)
            else:
                raise Usage(f"unknown cart command '{args.cart_cmd}'")
        else:
            raise Usage(f"unknown command '{args.cmd}'")

    except Usage as e:
        return emit(err(str(e), EX_USAGE), args.json)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except Blocked as e:
        return emit(err(str(e), EX_NET), args.json)
    except Net as e:
        return emit(err(str(e), EX_NET), args.json)
    except ApiError as e:
        return emit(err(str(e), EX_ERR, detail=e.detail), args.json)
    except KeyboardInterrupt:
        return emit(err("interrupted", EX_ERR), args.json)
    except Exception as e:
        return emit(err(f"internal error: {e}", EX_ERR), args.json)


if __name__ == "__main__":
    sys.exit(main())

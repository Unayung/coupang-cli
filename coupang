    # 4. Login Status & Cart Check
    login_ok = False
    login_info = "not signed in"
    cart_info = "unknown"
    if has_session:
        try:
            cl = Client(args, st)
            status, text = cl.request("GET", f"{CART_ORIGIN}/api/node/cart/content?isLogin=true", accept_json=True)
            data = json.loads(text)
            common = data.get("rData", {}).get("common", {})
            cart = data.get("rData", {}).get("shoppingCart", {})
            login_ok = bool(common.get("isLogin"))
            msrl = cart.get("memberSrl")
            uname = st.get("user", {}).get("name") or "member"
            login_info = f"signed in as {uname} (member_srl: {msrl})" if login_ok else "session invalid or expired"
            cart_info = f"{cart.get('totalItemCount', 0)} items in cart"
            cl.close()
        except Exception as e:
            login_info = f"check failed: {e}"
    results.append(("Login Status", login_ok, login_info))
    results.append(("Cart Status", login_ok, cart_info))

    def human():
        lines = ["Coupang CLI Doctor (coupang v" + VERSION + ")", "=" * 50]
        for name, is_ok, desc in results:
            sym = "[OK]" if is_ok else "[WARN]" if name == "Saved Session" and not is_ok else "[ERR]"
            lines.append(f"{name:<18} {sym:<6} {desc}")
        lines.append("=" * 50)
        all_ok = all(r[1] for r in results if r[0] != "Saved Session")
        lines.append("All systems operational." if all_ok else "Some checks reported warnings or errors.")
        return "\n".join(lines)

    data = {name.lower().replace(" ", "_"): {"ok": is_ok, "detail": desc} for name, is_ok, desc in results}
    return emit(ok(data), args.json, human)


PLACEHOLDER_PRICE = 99999  # Coupang's own sentinel for unavailable/placeholder-priced listings


def _search_extract_js():
    return r"""
    (() => {
        const lis = Array.from(document.querySelectorAll("#product-list > li, li.ProductUnit_productUnit__Qd6sv"));
        return lis.map(li => {
            const a = li.querySelector("a[href*='/products/']");
            const img = li.querySelector("img");
            const text = li.innerText || "";
            const href = a ? a.href : "";
            const rawHref = a ? (a.getAttribute("href") || "") : "";
            // Sponsored/ad slots carry sourceType=srp_product_ads in the raw link and are
            // pinned regardless of sort/page - they must never be treated as real results.
            const sponsored = rawHref.includes("sourceType=srp_product_ads") || rawHref.includes("clickEventId=");

            // Title
            let title = (img && img.alt && !img.alt.startsWith("$") && !img.alt.includes("回饋")) ? img.alt : "";
            if (!title) {
                const lines = text.split("\n").map(l => l.trim()).filter(l => l && !l.startsWith("$") && !l.includes("回饋") && !l.includes("折扣後") && l.length > 3);
                title = lines[0] || "";
            }

            // Prices
            const del = li.querySelector("del");
            const origPrice = del ? Number(del.innerText.replace(/[$,]/g, "")) : null;
            const priceEl = Array.from(li.querySelectorAll("*")).find(e => {
                const t = e.innerText ? e.innerText.trim() : "";
                return e.children.length === 0 && t && /^\$[\d,]+$/.test(t) && (!del || e !== del);
            });
            const price = priceEl ? Number(priceEl.innerText.replace(/[$,]/g, "")) : null;

            // Discount rate
            const discMatch = text.match(/(\d+)%/);
            const discount = discMatch ? discMatch[1] + "%" : null;

            // Reviews
            const revMatch = text.match(/\(([\d,]+)\)/);
            const reviews = revMatch ? Number(revMatch[1].replace(/,/g, "")) : null;

            // ID
            const m = href.match(/\/products\/(?:[^\s/?#]+-)?(\d+)/);
            const id = m ? m[1] : "";

            const m_item = href.match(/itemId=(\d+)/);
            const m_viid = href.match(/vendorItemId=(\d+)/);

            return {
                id,
                item_id: m_item ? m_item[1] : "",
                vendor_item_id: m_viid ? m_viid[1] : "",
                title,
                price,
                origin_price: origPrice && origPrice !== price ? origPrice : null,
                discount,
                rating: null,
                reviews,
                rocket: text.includes("火箭速配") || text.includes("酷澎直售") || text.includes("WOW免運"),
                out_of_stock: text.includes("缺貨") || text.includes("售完"),
                sponsored,
                url: href
            };
        }).filter(it => it.id);
    })()
    """


def _clean_search_items(raw_items):
    """Drops sponsored/ad slots (pinned, ignore sort+page) and placeholder/null prices.

    Returns (clean, dropped_ad_count, dropped_price_count) - clean items only, in
    the order Coupang returned them, each item's own 'sponsored' flag removed.
    """
    clean = []
    dropped_ad = dropped_price = 0
    for it in raw_items:
        if it.get("sponsored"):
            dropped_ad += 1
            continue
        price = it.get("price")
        if price is None or price <= 0 or price >= PLACEHOLDER_PRICE:
            dropped_price += 1
            continue
        it = dict(it)
        it.pop("sponsored", None)
        clean.append(it)
    return clean, dropped_ad, dropped_price


def cmd_search(args):
    q = " ".join(args.query).strip()
    if not q:
        raise Usage("search query required: `coupang search <keywords>`")
    sort_key = None
    if args.sort:
        sort_key = SORTS.get(args.sort.lower())
        if not sort_key:
            raise Usage(f"unknown sort '{args.sort}'. choices: {', '.join(sorted(set(SORTS)))}")
    is_price_sort = sort_key in ("salePriceAsc", "salePriceDesc")

    limit = args.limit or 20
    page = max(1, args.page or 1)
    need = page * limit

    def build_url(remote_page):
        params = {"q": q}
        if sort_key:
            params["sorter"] = sort_key
        if args.min:
            params["minPrice"] = str(int(args.min))
        if args.max:
            params["maxPrice"] = str(int(args.max))
        if remote_page > 1:
            params["page"] = str(remote_page)
        return f"{ORIGIN}/np/search?" + urllib.parse.urlencode(params)

    cl = Client(args)
    collected = []
    seen = set()
    total_dropped_ad = total_dropped_price = 0
    MAX_REMOTE_PAGES = 6
    try:
        br = cl.browser(url=build_url(1))
        js_extract = _search_extract_js()
        remote_page = 1
        while True:
            if remote_page > 1:
                time.sleep(1.2)  # human-rate pacing between fetches
                br.navigate(build_url(remote_page))
            t0 = time.time()
            while time.time() - t0 < 8:
                cnt = br.eval("document.querySelectorAll('#product-list > li').length") or 0
                if cnt > 2:
                    break
                time.sleep(0.5)

            raw_items = br.eval(js_extract) or []
            used_fallback = False
            if not raw_items:
                status, html = cl.request("GET", build_url(remote_page))
                raw_items = parse_search_html(html)
                used_fallback = True  # HTML fallback has no ad-detection field (undocumented upstream)

            clean, dropped_ad, dropped_price = (
                (raw_items, 0, 0) if used_fallback else _clean_search_items(raw_items)
            )
            if used_fallback:
                clean = [it for it in clean if it.get("price") not in (None,) and 0 < it["price"] < PLACEHOLDER_PRICE]
            total_dropped_ad += dropped_ad
            total_dropped_price += dropped_price

            new_count = 0
            for it in clean:
                # Dedupe on base product id alone: the same product can be listed
                # multiple times with different itemId/vendorItemId (variant/pack
                # options) at different prices - keep the first (cheapest for an
                # asc sort, since collected gets re-sorted below) and drop repeats
                # so the same product never shows up twice across pages.
                key = it["id"]
                if key in seen:
                    continue
                seen.add(key)
                collected.append(it)
                new_count += 1

            if is_price_sort:
                collected.sort(key=lambda x: x["price"], reverse=(sort_key == "salePriceDesc"))

            if len(collected) >= need or new_count == 0 or remote_page >= MAX_REMOTE_PAGES:
                break
            remote_page += 1

        if args.in_stock:
            collected = [it for it in collected if not it["out_of_stock"]]

        items = collected[(page - 1) * limit: page * limit]
    finally:
        cl.close()

    def human():
        if not items:
            return f"No results found for '{q}'"
        rows = []
        for it in items:
            t = clip(it["title"], 42)
            p = nt(it["price"])
            op = nt(it["origin_price"]) if it["origin_price"] and it["origin_price"] != it["price"] else ""
            disc = it["discount"] or ""
            r = f"{it['rating']} ★" if it.get("rating") else ""
            rev_cnt = num(it.get("reviews"))
            rev = f"({int(rev_cnt):,})" if rev_cnt is not None else ""
            rk = "火箭速配" if it.get("rocket") else ""
            # Human table shows a short canonical URL (full one is ~400 chars with
            # tracking params - sourceType/itemId/vendorItemId/clickEventId/etc and
            # floods the terminal). --json keeps the full tracked URL unchanged.
            short_url = f"{ORIGIN}/products/{it['id']}" if it.get("id") else (it["url"] or "")
            rows.append([it["id"], t, p, op, disc, r, rev, rk, short_url])
        hdrs = ["ID", "商品", "價格", "原價", "折扣", "評分", "評價", "運送", "URL"]
        return f"Coupang Search: '{q}' ({len(items)} results)\n" + table(rows, hdrs)

    out = {"query": q, "count": len(items), "items": items}
    return emit(ok(out), args.json, human)


def parse_product_from_browser(br, prod_url, spec_query=None):
    """Extracts product details, LD+JSON, options table via background tab."""
    br.navigate(prod_url)
    time.sleep(2)

    js_extract = r"""
    (() => {
        let ld = null;
        for (const s of document.querySelectorAll("script[type='application/ld+json']")) {
            try {
                const parsed = JSON.parse(s.innerText);
                if (parsed['@type'] === 'Product') { ld = parsed; break; }
            } catch(e) {}
        }
        
        let breadcrumbs = [];
        for (const s of document.querySelectorAll("script[type='application/ld+json']")) {
            try {
                const parsed = JSON.parse(s.innerText);
                if (parsed['@type'] === 'BreadcrumbList' && Array.isArray(parsed.itemListElement)) {
                    breadcrumbs = parsed.itemListElement.map(b => b.name);
                    break;
                }
            } catch(e) {}
        }

        const text = document.body.innerText || "";
        const title = (ld && ld.name) || document.querySelector("h1, .prod-buy-header__title")?.innerText?.trim();
        const brand = (ld && ld.brand && ld.brand.name) || document.querySelector(".prod-brand, a[href*='brand']")?.innerText?.trim();
        
        // Options / specs
        const options = Array.from(document.querySelectorAll(".option-table-list__option")).map(el => {
            const name = el.querySelector(".option-table-list__option-name")?.innerText?.trim() || el.innerText?.trim();
            const price = el.querySelector(".option-table-list__option-price")?.innerText?.trim() || "";
            const selected = el.className.includes("selected");
            return { name, price: price.replace(/\n+/g, " "), selected };
        });

        // Price parsing from text
        let price = null;
        let origPrice = ld && ld.offers && ld.offers.priceSpecification ? Number(ld.offers.priceSpecification.price) : null;
        let discount = null;
        let promoPrice = null;

        const discMatch = text.match(/折扣後價格\s*(?:[·•\d:apm\s]*)\n+(?:(\d+)折\n+)?\$([\d,]+)\n+\$([\d,]+)/);
        if (discMatch) {
            origPrice = Number(discMatch[2].replace(/,/g, ""));
            price = Number(discMatch[3].replace(/,/g, ""));
            discount = discMatch[1] ? (100 - Number(discMatch[1])) + "%" : null;
        } else {
            const singleMatch = text.match(/\$([\d,]+)\n+\(\$[\d.]+\/[^\)]+\)/);
            if (singleMatch) {
                price = Number(singleMatch[1].replace(/,/g, ""));
            } else if (ld && ld.offers && ld.offers.price && Number(ld.offers.price) > 10) {
                price = Number(ld.offers.price);
            }
        }

        const couponMatch = text.match(/會員優惠券折扣價\s*\n+(?:[^\n]+\n+)?\$([\d,]+)\n+\$([\d,]+)/);
        if (couponMatch) {
            promoPrice = Number(couponMatch[2].replace(/,/g, ""));
        }

        // Spec e.g. 每份數量 × 數量
        const specMatch = text.match(/每份數量\s*[×x]\s*數量\s*\n+([^\n]+)/);
        const spec = specMatch ? specMatch[1].trim() : (options.length > 0 ? options[0].name : null);

        // Rating
        let rating = ld && ld.aggregateRating && ld.aggregateRating.ratingValue ? Number(ld.aggregateRating.ratingValue) : null;
        let reviews = ld && ld.aggregateRating && ld.aggregateRating.ratingCount ? Number(ld.aggregateRating.ratingCount) : null;
        if (!reviews) {
            const revM = text.match(/([\d,]+)\s*筆商品評價/);
            if (revM) reviews = Number(revM[1].replace(/,/g, ""));
        }
        
        // Shipping / Delivery
        const delMatch = text.match(/明天[^\n]+預計送達[^\n]*/);
        const shipping = delMatch ? delMatch[0] : (text.includes("火箭速配") ? "火箭速配隔日送達, 滿 $490 免運" : "滿 $490 免運");

        // Stock
        const inStock = !text.includes("缺貨") && !text.includes("已售完");

        // Current item IDs from URL Query or Cart Button
        const currentUrl = window.location.href;
        
        return {
            title,
            brand,
            price,
            origPrice,
            discount,
            promoPrice,
            spec,
            rating,
            reviews,
            inStock,
            shipping,
            breadcrumbs,
            options,
            currentUrl
        };
    })()
    """
    data = br.eval(js_extract)
    if not data or not data.get("title"):
        raise ApiError(f"could not extract product details from {prod_url}")

    # Extract ID from URL
    m = re.search(r"/products/(?:[^\s/?#]+-)?(\d+)", prod_url)
    pid = m.group(1) if m else ""
    m_item = re.search(r"itemId=(\d+)", data.get("currentUrl") or prod_url)
    iid = m_item.group(1) if m_item else ""
    m_viid = re.search(r"vendorItemId=(\d+)", data.get("currentUrl") or prod_url)
    viid = m_viid.group(1) if m_viid else ""

    price = data.get("price")
    orig_price = data.get("origPrice")
    disc = data.get("discount")
    if not disc and price and orig_price and orig_price > price:
        disc = f"{round((1 - price/orig_price) * 100)}%"

    return {
        "id": pid,
        "item_id": iid,
        "vendor_item_id": viid,
        "title": data.get("title"),
        "brand": data.get("brand") or "",
        "price": price,
        "origin_price": orig_price,
        "discount": disc,
        "promo_coupon_price": data.get("promoPrice"),
        "spec": data.get("spec"),
        "rating": data.get("rating"),
        "reviews": data.get("reviews"),
        "in_stock": data.get("inStock", True),
        "shipping": data.get("shipping"),
        "category": " > ".join(data.get("breadcrumbs") or []),
        "variants": data.get("options") or [],
        "url": data.get("currentUrl") or prod_url,
    }


def resolve_product_url(arg):
    arg = str(arg).strip()
    if arg.startswith("http://") or arg.startswith("https://"):
        return arg
    digits = re.sub(r"\D", "", arg)
    if not digits:
        raise Usage(f"invalid product id or url: '{arg}'")
    return f"{ORIGIN}/products/{digits}"


def cmd_product(args):
    url = resolve_product_url(args.product)
    cl = Client(args)
    try:
        # Product details are richest when evaluated in background tab
        br = cl.browser(url=url)
        prod = parse_product_from_browser(br, url)
    finally:
        cl.close()

    def human():
        rev_val = num(prod.get("reviews"))
        rev_str = f" ({int(rev_val):,} 則評價)" if rev_val is not None else ""
        lines = [
            prod["title"],
            f"品牌:     {prod['brand'] or 'N/A'}",
            f"商品 ID:  {prod['id']}" + (f" (Item: {prod['item_id']}, VendorItem: {prod['vendor_item_id']})" if prod.get('item_id') else ""),
            f"售價:     {nt(prod['price'])}" + (f" (原價 {nt(prod['origin_price'])}, 折扣 {prod['discount']})" if prod.get("origin_price") else ""),
            f"評分:     {prod['rating']} ★{rev_str}" if prod.get("rating") else "評分:     無評價",
            f"庫存:     {'現貨' if prod.get('in_stock') else '已售完/缺貨'}",
            f"運送:     {prod['shipping']}",
            f"分類:     {prod['category']}" if prod.get("category") else "",
            f"網址:     {prod['url']}",
        ]
        if prod.get("variants"):
            lines.append(f"\n規格/選項 ({len(prod['variants'])}):")
            for v in prod["variants"]:
                sel = " [已選取]" if v.get("selected") else ""
                lines.append(f"  - {v['name']}: {v['price']}{sel}")
        return "\n".join(l for l in lines if l)

    return emit(ok(prod), args.json, human)


def cmd_price(args):
    if not args.products:
        raise Usage("specify one or more product ids or urls: `coupang price <id>...`")
    cl = Client(args)
    results = []
    try:
        br = cl.browser()
        for p in args.products:
            url = resolve_product_url(p)
            try:
                prod = parse_product_from_browser(br, url)
                results.append({
                    "id": prod["id"],
                    "title": prod["title"],
                    "price": prod["price"],
                    "origin_price": prod["origin_price"],
                    "discount": prod["discount"],
                    "in_stock": prod["in_stock"],
                    "checked_at": time.strftime("%Y-%m-%d %H:%M:%S"),
                    "url": prod["url"]
                })
            except Exception as e:
                results.append({
                    "id": p,
                    "error": str(e),
                    "checked_at": time.strftime("%Y-%m-%d %H:%M:%S")
                })
    finally:
        cl.close()

    def human():
        rows = []
        for r in results:
            if "error" in r:
                rows.append([r["id"], clip(r["error"], 40), "", "", "", "", r["checked_at"]])
            else:
                rows.append([
                    r["id"],
                    clip(r["title"], 40),
                    nt(r["price"]),
                    nt(r["origin_price"]) if r["origin_price"] else "",
                    r["discount"] or "",
                    "現貨" if r["in_stock"] else "缺貨",
                    r["checked_at"]
                ])
        hdrs = ["ID", "商品", "價格", "原價", "折扣", "庫存", "檢查時間"]
        return table(rows, hdrs)

    return emit(ok(results), args.json, human)


def cmd_raw(args):
    path = args.path
    if not path.startswith("http"):
        path = urllib.parse.urljoin(ORIGIN, path)
    cl = Client(args)
    try:
        status, text = cl.request("GET", path)
    finally:
        cl.close()
    if args.json:
        try:
            return emit(ok(json.loads(text)), True)
        except Exception:
            return emit(ok({"status": status, "raw": text}), True)
    print(text)
    return EX_OK


